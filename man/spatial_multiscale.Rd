lon <- runif(n, 0, 10)
lat <- runif(n, 0, 10)
w <- 0.5 * sin(lon / 3) + 0.5 * cos(lat / 3) + 0.3 * sin(2 * lon) * cos(2 * lat)
depth <- rnorm(n)
temp <- rnorm(n)
df <- data.frame(
