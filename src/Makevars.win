# Enable OpenMP for parallel chain execution
# Non-optimizing Eigen builds can exceed the plain COFF section ceiling.
comma := ,
# The last optimization flag determines whether template sections are merged.
BIGOBJ_FLAG = $(if $(filter -O2 -O3 -Os -Ofast,$(lastword $(filter -O%,$(CXXFLAGS)))),,-Wa$(comma)-mbig-obj)
# GCC diagnostics retain each warning and one template instantiation context.
DIAG_FLAGS = $(if $(findstring clang,$(CXX)),,-fno-diagnostics-show-caret -ftemplate-backtrace-limit=1)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) $(BIGOBJ_FLAG) $(DIAG_FLAGS) -DEIGEN_NO_DEBUG
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
CXX_STD = CXX17

